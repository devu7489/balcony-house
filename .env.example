# Copy to .env and fill in real values before running docker compose.

# Google OAuth 2.0 credentials (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URIs to register (see README.md "Google Cloud setup" for details):
#   http://localhost:8081/login/oauth2/code/google  (docker compose - the default way to run this)
#   http://localhost:8080/login/oauth2/code/google  (non-Docker dev mode only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the backend redirects users after login/logout
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Set to true once served over HTTPS in production
COOKIE_SECURE=false

# Comma-separated list of Google account emails granted admin access
ADMIN_EMAILS=

# Booking confirmation/cancellation emails, sent via Resend (resend.com - free tier covers
# a boutique property comfortably). Leave EMAIL_ENABLED=false until you've signed up and
# verified a sending domain there - without a verified domain, Resend only delivers to your
# own account email, never to real guest addresses.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
