# Copy this file to ".env" on the production server (docker compose auto-loads
# a file literally named ".env" - no --env-file flag needed) and fill in real
# values. Never commit the real ".env" - it's already in .gitignore.

# The domain Caddy should get an HTTPS certificate for, e.g. thebalconyhouse.com
# (no scheme, no port - Caddy adds automatic HTTPS for anything that isn't
# "localhost" or a bare IP).
SITE_ADDRESS=yourdomain.com

# Caddy is genuinely terminating HTTPS here (not the case for local dev), so
# tell it to report that accurately to the backend - otherwise the computed
# OAuth2 redirect_uri comes out as http:// instead of https:// and Google
# rejects it. Always "https" in production.
FORWARDED_PROTO=https

# A strong, unique password - this is NOT the local dev default.
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# From the same Google Cloud OAuth client already used for local dev - just add
# https://yourdomain.com/login/oauth2/code/google as an extra authorized
# redirect URI on it, no need for a second client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Must be true in production - Caddy terminates real HTTPS, so the session
# cookie can (and should) require it.
COOKIE_SECURE=true

# Comma-separated list of Google account emails that should get admin access.
ADMIN_EMAILS=you@example.com
